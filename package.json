{
  "name": "utsav-frontend-tooling",
  "private": true,
  "description": "Lint and format tooling for Utsav's static frontend (no build step; nothing here ships to production).",
  "type": "module",
  "scripts": {
    "lint": "eslint static/js",
    "format": "prettier --write \"static/**/*.{js,css}\"",
    "format:check": "prettier --check \"static/**/*.{js,css}\""
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.4.2"
  }
}
