rules_version = '2';
// Utsav reads and writes Firestore only from the server (Admin SDK).
// Browsers get no direct access to any document.
// In the shared promptwar-501405 project the deployed rules already end with this
// same deny-all catch-all, which covers planner_users/**. Deploy this file as-is
// only in a project dedicated to Utsav.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
