# Copy to .env for local runs. Never commit real values.
# Gemini via Vertex AI uses the runtime service account (no key needed):
USE_VERTEXAI=true
GCP_PROJECT=your-gcp-project
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Or the Developer API with a key (set USE_VERTEXAI=false):
GEMINI_API_KEY=replace-me
# Firebase web config (public values):
FIREBASE_API_KEY=replace-me
FIREBASE_AUTH_DOMAIN=your-gcp-project.firebaseapp.com
# memory (local dev, tests) or firestore (production)
STORE=memory
